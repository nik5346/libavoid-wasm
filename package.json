{
  "name": "libavoid-wasm",
  "version": "0.1.0",
  "description": "WebAssembly (Embind) bindings for libavoid (Adaptagrams) — object-avoiding orthogonal and polyline connector routing, with a typed TypeScript API.",
  "keywords": [
    "libavoid",
    "adaptagrams",
    "wasm",
    "webassembly",
    "connector-routing",
    "graph-layout",
    "diagram",
    "orthogonal-routing",
    "embind"
  ],
  "homepage": "https://github.com/YOUR_GH_USER/libavoid-wasm",
  "bugs": "https://github.com/YOUR_GH_USER/libavoid-wasm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GH_USER/libavoid-wasm.git"
  },
  "license": "LGPL-2.1-or-later",
  "author": "YOUR_NAME",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wasm": {
      "types": "./dist/libavoid.d.ts",
      "import": "./dist/libavoid.js"
    },
    "./libavoid.wasm": "./dist/libavoid.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE.LGPL",
    "README.md"
  ],
  "scripts": {
    "fetch:adaptagrams": "python scripts/fetch_adaptagrams.py",
    "install:emscripten": "python scripts/install_emscripten.py",
    "build:wasm": "python scripts/build_wasm.py",
    "build:ts": "tsup ts/index.ts --format esm,cjs --dts --out-dir dist --clean=false",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.0",
    "tsup": "^8.3.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
